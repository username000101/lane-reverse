<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LaneWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaneWinUI"
    xmlns:core="using:LaneWinUI.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- AUTH VIEW (When user is not signed in)                         -->
        <!-- ============================================================== -->
        <Grid x:Name="AuthContainer" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Width="440" Padding="32" Background="{StaticResource LaneCardBrush}"
                    BorderBrush="{StaticResource LaneCardBorderBrush}" BorderThickness="1" CornerRadius="20">
                <StackPanel Spacing="20">
                    <!-- Brand Header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource LaneGradientBrush}">
                            <FontIcon Glyph="&#xE8D6;" Foreground="#0C0C0E" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lane Music" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Авторизация через Telegram" FontSize="11" Foreground="{StaticResource LaneTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- QR Code Frame -->
                    <Border HorizontalAlignment="Center" Width="220" Height="220" Background="White" CornerRadius="16" Padding="10">
                        <Image x:Name="QrCodeImage" Stretch="Uniform" />
                    </Border>

                    <!-- Telegram Deep Link Button -->
                    <Button x:Name="OpenTelegramButton" Click="OpenTelegramButton_Click" HorizontalAlignment="Stretch" Height="42"
                            Background="#0088CC" Foreground="White" CornerRadius="10" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE715;" FontSize="15" />
                            <TextBlock Text="Открыть бота @lane_music_bot" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Polling Status Pulse -->
                    <Border Background="#14201E" BorderBrush="#223E3A" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing IsActive="True" Width="16" Height="16" Foreground="{StaticResource LaneMintBrush}" />
                            <TextBlock Text="Ожидание нажатия START в боте..." FontSize="12" Foreground="{StaticResource LaneMintBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Security & Info -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DeviceIdText" Text="Устройство: ..." FontSize="10" Foreground="{StaticResource LaneTextMutedBrush}" HorizontalAlignment="Center" FontFamily="Consolas" />
                        <TextBlock Text="Подпись BNIT v1.4.7 • Без логина и пароля" FontSize="11" Foreground="{StaticResource LaneTextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- APP LIBRARY VIEW (When user is signed in)                      -->
        <!-- ============================================================== -->
        <Grid x:Name="AppContainer" Grid.Row="0" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource LaneCardBrush}"
                    BorderBrush="{StaticResource LaneCardBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- User Profile & Action Chips -->
                    <StackPanel Grid.Row="0" Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource LaneGradientBrush}">
                                <FontIcon Glyph="&#xE77B;" Foreground="#0C0C0E" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="Lane User" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <Border Margin="0,3,0,0" HorizontalAlignment="Left" Background="#263820" CornerRadius="4" Padding="6,1">
                                    <TextBlock x:Name="UserVipText" Text="VIP PASS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LaneMintBrush}" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Click="ConfigButton_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="Экспорт конфигурации (laned.json)">
                                <FontIcon Glyph="&#xE8C8;" FontSize="15" Foreground="{StaticResource LaneTextSecondaryBrush}" />
                            </Button>
                        </Grid>

                        <MenuFlyoutSeparator Margin="0,4" />
                    </StackPanel>

                    <!-- Pinned "Favorites" Tab -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,10">
                        <TextBlock Text="МОЯ МЕДИАТЕКА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LaneTextMutedBrush}" Margin="8,0,0,4" />
                        <Button x:Name="FavoritesNavButton" Click="FavoritesNavButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="#1A2E35" BorderBrush="{StaticResource LaneCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Grid HorizontalAlignment="Stretch" Width="216">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEB51;" Foreground="#FF3366" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Мне нравится" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="FavCountText" Grid.Column="2" Text="0" FontSize="11" Foreground="{StaticResource LaneTextSecondaryBrush}" VerticalAlignment="Center" FontFamily="Consolas" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- User Playlists List -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ПЛЕЙЛИСТЫ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LaneTextMutedBrush}" Margin="8,0,0,6" />
                        <ListView x:Name="PlaylistsListView" Grid.Row="1" SelectionChanged="PlaylistsListView_SelectionChanged" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:LanePlaylist">
                                    <Grid Padding="6,6" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8D6;" Foreground="{StaticResource LaneCyanBrush}" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" Margin="8,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind TracksCount}" FontSize="10" Foreground="{StaticResource LaneTextMutedBrush}" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Main Tracks Table -->
            <Grid Grid.Column="1" Margin="24,18,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Playlist Top Banner -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="14" Background="{StaticResource LaneGradientBrush}">
                        <FontIcon Glyph="&#xEB51;" Foreground="#0C0C0E" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="ПЛЕЙЛИСТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LaneTextMutedBrush}" />
                        <TextBlock x:Name="CurrentPlaylistTitle" Text="Мне нравится" FontSize="26" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="CurrentPlaylistSubtitle" Text="0 треков • Стриминг ULTRA (320 kbps)" FontSize="12" Foreground="{StaticResource LaneTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Play All Button & Search -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <AutoSuggestBox x:Name="TrackSearchBox" QuerySubmitted="TrackSearchBox_QuerySubmitted" TextChanged="TrackSearchBox_TextChanged"
                                        PlaceholderText="Поиск трека..." Width="220" />
                        <Button x:Name="PlayAllButton" Click="PlayAllButton_Click" Background="{StaticResource LaneCyanBrush}" Foreground="#0C0C0E"
                                Height="36" Padding="14,0" CornerRadius="8" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="Слушать всё" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,8" />

                <!-- Tracks Table -->
                <Grid Grid.Row="2">
                    <ListView x:Name="TracksListView" DoubleTapped="TracksListView_DoubleTapped" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:LaneTrack">
                                <Grid Padding="8,6" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Soundwave or play icon -->
                                    <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource LaneTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <!-- Cover thumbnail -->
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" Background="#26262E">
                                        <Image Source="{x:Bind CoverUrl}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Title + Explicit badge -->
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Visibility="{x:Bind Explicit}" Background="#2E2E38" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="E" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LaneTextMutedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Artist -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind ArtistsDisplayedName}" Foreground="{StaticResource LaneTextSecondaryBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4" Text="{x:Bind DurationFormatted}" Foreground="{StaticResource LaneTextMutedBrush}" FontSize="11"
                                               FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ProgressRing x:Name="TracksLoadingRing" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="40" Height="40" Foreground="{StaticResource LaneCyanBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- PERSISTENT DOCKED BOTTOM PLAYER BAR                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="#121216" BorderBrush="{StaticResource LaneCardBorderBrush}" BorderThickness="0,1,0,0" Height="86">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Current Track Details -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" Background="#222228">
                        <Image x:Name="PlayerCoverImage" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerTrackTitle" Text="Ничего не играет" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlayerTrackArtists" Text="Выберите трек для воспроизведения" Foreground="{StaticResource LaneTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Center Column: Transport Controls & Scrubber -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="600" Spacing="4">
                    <!-- Transport Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <Button Click="PrevButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE892;" FontSize="15" Foreground="White" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Width="40" Height="40" CornerRadius="20"
                                Background="{StaticResource LaneCyanBrush}" Foreground="#0C0C0E" Padding="0">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Click="NextButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE893;" FontSize="15" Foreground="White" />
                        </Button>
                    </StackPanel>

                    <!-- Scrubber Slider -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PlayerElapsedText" Grid.Column="0" Text="0:00" FontSize="11" Foreground="{StaticResource LaneTextMutedBrush}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="PlayerScrubberSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                PointerCaptureLost="PlayerScrubberSlider_PointerCaptureLost" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerTotalText" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{StaticResource LaneTextMutedBrush}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Right Column: Quality, Volume, Config -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <!-- Live Bitrate Selector -->
                    <DropDownButton x:Name="QualityButton" Content="ULTRA (320k)" FontSize="11" FontFamily="Consolas" Padding="8,4" CornerRadius="6">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="BASIC (128 kbps)" Click="QualityItem_Click" Tag="BASIC" />
                                <MenuFlyoutItem Text="HIGH (192 kbps)" Click="QualityItem_Click" Tag="HIGH" />
                                <MenuFlyoutItem Text="ULTRA (320 kbps)" Click="QualityItem_Click" Tag="ULTRA" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Volume Icon and Slider -->
                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{StaticResource LaneTextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />

                    <!-- Logout Button -->
                    <Button Click="LogoutButton_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="Выйти из аккаунта">
                        <FontIcon Glyph="&#xE8F8;" FontSize="15" Foreground="{StaticResource LaneTextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
