<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LaneWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaneWinUI"
    xmlns:core="using:LaneWinUI.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- AUTH VIEW (Unigram Onboarding Card Style)                     -->
        <!-- ============================================================== -->
        <Grid x:Name="AuthContainer" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="460" Padding="36"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="20">
                    <!-- Brand Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="20"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                      FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lane Music" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="Авторизация через Telegram" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- QR Code Card -->
                    <Border HorizontalAlignment="Center" Width="220" Height="220"
                            Background="White" CornerRadius="12" Padding="12"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Image x:Name="QrCodeImage" Stretch="Uniform" />
                    </Border>

                    <!-- Telegram Deep Link Action -->
                    <Button x:Name="OpenTelegramButton" Click="OpenTelegramButton_Click"
                            HorizontalAlignment="Stretch" Height="40"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE715;" FontSize="15" />
                            <TextBlock Text="Открыть бота @lane_music_bot" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Radar Polling State -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="Ожидание нажатия START в Telegram-боте..."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Device Info & Crypto Tag -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DeviceIdText" Text="Устройство: ..."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" FontFamily="Consolas" />
                        <TextBlock Text="Подпись BNIT v1.4.7 • Нативный клиент Windows"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MAIN APP VIEW (Fluent NavigationView + Master Detail)          -->
        <!-- ============================================================== -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            CompactPaneLength="48"
            SelectionChanged="NavView_SelectionChanged"
            Visibility="Visible">

            <!-- Search in Navigation Header -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    QueryIcon="Find"
                    PlaceholderText="Поиск треков..."
                    TextChanged="SearchBox_TextChanged"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    Margin="0,0,12,0" />
            </NavigationView.AutoSuggestBox>

            <!-- Navigation Items: Library & Playlists -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="FavoritesNavItem" Content="Мне нравится" Tag="lane_likes" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" Foreground="{StaticResource LaneHeartBrush}" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="FavCountBadge" Value="0" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="ПЛЕЙЛИСТЫ" />
            </NavigationView.MenuItems>

            <!-- Navigation Footer: Profile, Config, Logout -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ProfileNavItem" Content="Lane User" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="VipInfoBadge" Style="{StaticResource AttentionDotInfoBadgeStyle}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ConfigNavItem" Content="Конфигурация (laned.json)" Tag="config" Tapped="ConfigNavItem_Tapped" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="LogoutNavItem" Content="Выйти из аккаунта" Tag="logout" Tapped="LogoutNavItem_Tapped" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F8;" Foreground="#FF453A" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Main Library Content Area -->
            <Grid Padding="36,12,36,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero Playlist Header (Fluent Master Header) -->
                <Grid Grid.Row="0" Margin="0,8,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <FontIcon Glyph="&#xEB51;" Foreground="{StaticResource LaneHeartBrush}" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PlaylistCoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="ПЛЕЙЛИСТ" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentPlaylistTitle" Text="Мне нравится"
                                   Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="Bold" />
                        <TextBlock x:Name="CurrentPlaylistSubtitle" Text="0 треков • Lane Music"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Play All Action Button -->
                    <Button Grid.Column="2" x:Name="PlayAllButton" Click="PlayAllButton_Click"
                            Style="{StaticResource AccentButtonStyle}" Height="38" Padding="16,0"
                            CornerRadius="{ThemeResource ControlCornerRadius}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Слушать всё" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Column Headers Bar -->
                <Border Grid.Row="1" Padding="12,6" Margin="0,0,0,6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="НАЗВАНИЕ" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="3" Text="ИСПОЛНИТЕЛЬ" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="10,0" />
                        <TextBlock Grid.Column="4" Text="ВРЕМЯ" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Tracks Table (Fluent ListView with hover and selection) -->
                <Grid Grid.Row="2">
                    <ListView x:Name="TracksListView" DoubleTapped="TracksListView_DoubleTapped"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource TrackListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Soundwave / Play icon -->
                                    <SymbolIcon Grid.Column="0" Symbol="Audio" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Album Cover -->
                                    <Border Grid.Column="1" Width="38" Height="38"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Title & Explicit Badge -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Artist -->
                                    <TextBlock Grid.Column="3" Text="{Binding ArtistsDisplayedName}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4" Text="{Binding DurationFormatted}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ProgressRing x:Name="TracksLoadingRing" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="36" Height="36" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- ============================================================== -->
        <!-- NATIVE DOCKED PLAYER SHELF (Windows 11 Media Player Style)     -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Height="82"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Current Track Details -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Image x:Name="PlayerCoverImage" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="PlayerTrackTitle" Text="Ничего не играет"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlayerTrackArtists" Text="Выберите трек для воспроизведения"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Center Column: Transport Controls & Scrubber -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="580" Spacing="2">
                    <!-- Transport Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Click="PrevButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Width="38" Height="38"
                                CornerRadius="19" Style="{StaticResource AccentButtonStyle}" Padding="0">
                            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                        </Button>
                        <Button Click="NextButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                    </StackPanel>

                    <!-- Scrubber Slider -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PlayerElapsedText" Grid.Column="0" Text="0:00"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="PlayerScrubberSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                PointerCaptureLost="PlayerScrubberSlider_PointerCaptureLost" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerTotalText" Grid.Column="2" Text="0:00"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Right Column: Stream Quality, Volume, Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                    <!-- Live Bitrate DropDownButton -->
                    <DropDownButton x:Name="QualityButton" Content="ULTRA (320k)"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    FontSize="11" FontFamily="Consolas" Padding="8,4">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="BASIC (128 kbps)" Click="QualityItem_Click" Tag="BASIC" />
                                <MenuFlyoutItem Text="HIGH (192 kbps)" Click="QualityItem_Click" Tag="HIGH" />
                                <MenuFlyoutItem Text="ULTRA (320 kbps)" Click="QualityItem_Click" Tag="ULTRA" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Volume Control -->
                    <SymbolIcon Symbol="Volume" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="100"
                            ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
