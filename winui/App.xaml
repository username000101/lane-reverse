<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LaneWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LaneWinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand Colors -->
            <SolidColorBrush x:Key="LaneHeartBrush" Color="#FF3B6B" />

            <!-- Authentic Windows 11 List Item Container Style -->
            <Style x:Key="TrackListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinHeight" Value="52" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
